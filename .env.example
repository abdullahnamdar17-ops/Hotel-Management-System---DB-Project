# Set in Vercel's Environment Variables; this reference file is not auto-loaded.
MYSQL_HOST=your-online-database-hostname
MYSQL_PORT=4000
MYSQL_USER=your-provider-username
MYSQL_PASSWORD=your-provider-password
MYSQL_DATABASE=hotel_management_system
MYSQL_SSL_VERIFY=true
# Optional full PEM certificate with actual newlines, for a private CA:
# MYSQL_SSL_CA_PEM=

# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-random-secret
ADMIN_PASSWORD=choose-a-strong-staff-password
APP_TIMEZONE=Asia/Karachi

# LOCAL DEVELOPMENT ONLY (the original Streamlit secrets file can be reused):
# HMS_LOCAL_SECRETS_FILE=/absolute/path/to/your/.streamlit/secrets.toml
# With environment settings for a local server, MYSQL_SSL_VERIFY=false is allowed.
